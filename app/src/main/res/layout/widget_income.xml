<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/widget_income_bg">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GANHOS HOJE"
            android:textColor="#54818B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
        <TextView
            android:id="@+id/widget_income_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="R$ 0,00"
            android:textColor="#16465A"
            android:textSize="24sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:includeFontPadding="false" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="ÚLTIMOS 7 DIAS"
            android:textColor="#54818B"
            android:textSize="9sp"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_income_chart"
        android:layout_width="116dp"
        android:layout_height="58dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Gráfico de ganhos dos últimos sete dias"
        android:scaleType="fitCenter" />
</LinearLayout>
